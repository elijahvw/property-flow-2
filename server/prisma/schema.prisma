// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String     @id @default(cuid())
  name      String
  domain    String?    @unique
  legalName String?
  contactName String?
  contactEmail String?
  contactPhone String?
  website String?
  addressLine1 String?
  addressLine2 String?
  city String?
  region String?
  postalCode String?
  country String?
  timezone String @default("America/New_York")
  adminNotes String?
  version Int @default(1)
  createdById String?
  submissionKey String?
  submissionHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  residentContacts ResidentContact[]
  users     User[]
  properties Property[]
  status     String @default("active")
  memberships CompanyMembership[]
  invitations Invitation[]
  maintenanceRequests MaintenanceRequest[]
  units Unit[]
  leases Lease[]
  ledgerEntries LedgerEntry[]
  @@unique([createdById, submissionKey])
}

model User {
  accountProfile AccountProfile?
  id         String   @id // This will be the Auth0 ID
  email      String   @unique
  name       String?
  role       String   @default("unassigned") // Legacy migration evidence; never authorizes requests.
  platformRole String?
  status     String   @default("active")
  accessInitializedAt DateTime?
  emailVerified Boolean @default(false)
  verificationSentAt DateTime?
  passwordSetupSentAt DateTime?
  firstSignedInAt DateTime?
  provisions UserProvision[]
  identities Identity[]
  maintenanceRequests MaintenanceRequest[]
  leases Lease[] @relation("LeaseResident")
  createdMaintenanceUpdates MaintenanceUpdate[]
  createdMaintenanceCosts MaintenanceCost[] @relation("MaintenanceCostCreator")
  unlinkedMaintenanceCosts MaintenanceCost[] @relation("MaintenanceCostUnlinker")
  residentContacts ResidentContact[] @relation("ContactAccount")
  accountInvitations Invitation[] @relation("InvitationAccount")
  createdResidentContacts ResidentContact[] @relation("ContactCreator")
  leaseParticipants LeaseParticipant[]
  createdLeaseParticipants LeaseParticipant[] @relation("LeaseParticipantCreator")
  approvedLeaseInvitations Invitation[] @relation("LeaseInvitationApprover")
  createdLeases Lease[] @relation("LeaseCreator")
  createdUnits Unit[]
  createdLedgerEntries LedgerEntry[]
  createdDepositAccounts DepositAccount[] @relation("DepositAccountCreator")
  createdDepositRevisions DepositRevision[] @relation("DepositRevisionCreator")
  createdDepositReceipts DepositReceipt[] @relation("DepositReceiptCreator")
  documentVersions DocumentVersion[]
  workOrderActions WorkOrderAction[]
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceAssignee")
  membership CompanyMembership?
  sessions Session[]
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model Identity {
  id String @id @default(cuid())
  issuer String
  subject String
  userId String
  user User @relation(fields: [userId], references: [id])
  @@unique([issuer, subject])
}

model CompanyMembership {
  maintenanceExecution Boolean @default(false)
  staffPropertyScope String @default("all")
  staffProperties StaffPropertyAccess[]
  contactName String?
  contactPhone String?
  emergencyContactName String?
  emergencyContactPhone String?
  managementNotes String?
  userId String @id
  companyId String
  role String
  status String @default("active")
  version Int @default(1)
  user User @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments ResidentPropertyAssignment[]
  @@unique([userId, companyId])
  @@index([companyId])
}

model Invitation {
  accountId String?
  account User? @relation("InvitationAccount", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([accountId])
  contactLeaseApprovals Json?
  contactId String?
  contact ResidentContact? @relation(fields:[contactId,companyId],references:[id,companyId],onDelete:Restrict,onUpdate:Restrict)
  @@index([companyId,contactId])
  leaseId String?
  propertyId String?
  participantRole String?
  participantName String?
  participantStartsOn DateTime? @db.Date
  approvedAt DateTime?
  approvedBy String?
  lease Lease? @relation(fields: [leaseId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "Invitation_lease_fkey")
  approver User? @relation("LeaseInvitationApprover", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  email String
  role String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([companyId])
  @@index([companyId, leaseId])
}

model Session {
  tokenHash String @id
  csrfToken String
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  idleExpiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model LoginTransaction {
  stateHash String @id
  bindingHash String
  verifier String
  nonce String
  returnTo String
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorId String
  companyId String?
  action String
  targetId String?
  detail Json?
  requestId String
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

model Property {
  staffAccess StaffPropertyAccess[]
  propertyType String?
  yearBuilt Int?
  parcelId String?
  countryCode String?
  notes String?
  version Int @default(1)
  createdById String?
  submissionKey String?
  submissionHash String?
  @@unique([companyId, createdById, submissionKey])
  units Unit[]
  leases Lease[]
  ledgerEntries LedgerEntry[]
  maintenanceRequests MaintenanceRequest[]
  assignments ResidentPropertyAssignment[]
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@unique([id, companyId])
}

model StaffPropertyAccess {
  companyId String
  propertyId String
  userId String
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  membership CompanyMembership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade, onUpdate: Restrict)
  @@id([propertyId, userId])
  @@index([companyId, userId])
}

model ResidentPropertyAssignment {
  companyId String
  propertyId String
  userId String
  createdAt DateTime @default(now())
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  membership CompanyMembership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Restrict)
  @@id([propertyId, userId])
  @@index([companyId, userId])
}

model MaintenanceRequest {
  documents PrivateDocument[]
  assignee User? @relation("MaintenanceAssignee",fields:[assigneeId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  assigneeId String?
  executionStatus String @default("unassigned")
  workActions WorkOrderAction[]
  @@index([companyId, assigneeId, executionStatus])
  costs MaintenanceCost[]
  updates MaintenanceUpdate[]
  submissionKey String?
  submissionHash String?
  @@unique([companyId, requesterId, submissionKey])
  id String @id @default(cuid())
  companyId String
  propertyId String
  requesterId String
  unitId String?
  category String @default("other")
  targetOn DateTime? @db.Date
  version Int @default(1)
  unit Unit? @relation(fields: [unitId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "maintenance_unit_scope")
  title String
  description String
  priority String @default("normal")
  status String @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  requester User @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([companyId, status, propertyId])
  @@index([companyId, requesterId])
  @@index([companyId, unitId], map: "maintenance_unit_lookup")
  @@unique([id, companyId])
  @@unique([id, propertyId, companyId])
}

model MaintenanceCost {
  id String @id @default(cuid())
  companyId String
  propertyId String
  requestId String
  entryId String
  createdById String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  version Int @default(1)
  unlinkedAt DateTime?
  unlinkedById String?
  unlinkReason String?
  request MaintenanceRequest @relation(fields: [requestId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  entry LedgerEntry @relation(fields: [entryId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("MaintenanceCostCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unlinker User? @relation("MaintenanceCostUnlinker", fields: [unlinkedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, requestId, id])
  @@index([companyId, entryId])
}

model MaintenanceUpdate {
  id String @id @default(cuid())
  companyId String
  requestId String
  content String
  visibility String @default("internal")
  createdById String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  request MaintenanceRequest @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, requestId, createdAt, id])
}

model Unit {
  bedrooms Int?
  bathroomsHundredths Int?
  squareFeet Int?
  marketRentCents Int?
  floor String?
  notes String?
  createdById String
  submissionKey String
  submissionHash String
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  id String @id @default(cuid())
  companyId String
  propertyId String
  label String
  status String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  maintenanceRequests MaintenanceRequest[]
  leases Lease[]
  @@unique([id, propertyId, companyId])
  @@unique([companyId, propertyId, label])
  @@index([companyId, propertyId, id])
}
model ResidentContact {
  status String @default("active")
  preferredName String?
  alternatePhone String?
  preferredContact String?
  addressLine1 String?
  addressLine2 String?
  city String?
  region String?
  postalCode String?
  country String?
  emergencyRelationship String?
  createdById String?
  submissionKey String?
  submissionHash String?
  creator User? @relation("ContactCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  compatibilityProfile Json?
  id String @id @default(cuid())
  companyId String
  userId String?
  name String
  email String?
  phone String?
  emergencyContactName String?
  emergencyContactPhone String?
  managementNotes String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User? @relation("ContactAccount", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitations Invitation[]
  primaryLeases Lease[]
  participants LeaseParticipant[]
  @@unique([id, companyId])
  @@unique([companyId, userId])
  @@index([companyId, name, id])
}

model Lease {
  documents PrivateDocument[]
  @@unique([id, companyId])
 prorations LeaseProration[]
 transitions LeaseTransition[] @relation("TransitionOld")
 successorTransitions LeaseTransition[] @relation("TransitionNew")
  termChanges LeaseTermChange[]
  settlement LeaseSettlement?
  movements LeaseMovement[]
  residentContactId String?
  residentContact ResidentContact? @relation(fields: [residentContactId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  @@index([companyId, residentContactId])
  participants LeaseParticipant[]
  residentInvitations Invitation[]
 depositAccounts DepositAccount[]
 @@unique([companyId,previousLeaseId])
 previousLeaseId String?
 previousLease Lease? @relation("LeaseRenewals",fields:[previousLeaseId,unitId,propertyId,companyId],references:[id,unitId,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
 renewals Lease[] @relation("LeaseRenewals")
 @@unique([id,unitId,propertyId,companyId],map:"Lease_renewal_identity")
  rentSchedules RentSchedule[]
  rentDueDay Int @default(1)
  graceDays Int @default(0)
  paymentInstructions String?
  rentCharges RentCharge[]
  rentPayments LedgerEntry[]
  @@unique([id, propertyId, companyId])
  id String @id @default(cuid())
  companyId String
  propertyId String
  unitId String
  residentId String?
  createdById String
  submissionKey String
  submissionHash String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  rentCents Int
  currency String @default("USD")
  status String @default("draft")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  unit Unit @relation(fields: [unitId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  resident User? @relation("LeaseResident", fields: [residentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("LeaseCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, propertyId, id])
  @@index([companyId, unitId])
}

model LeaseParticipant {
  contactId String?
  contact ResidentContact? @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  @@index([companyId, contactId])
  removedAt DateTime?
  portalApproved Boolean @default(true)
  id String @id @default(cuid())
  companyId String
  propertyId String
  leaseId String
  userId String?
  name String
  email String?
  phone String?
  role String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  version Int @default(1)
  createdById String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lease Lease @relation(fields: [leaseId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("LeaseParticipantCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([leaseId, userId])
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, leaseId])
  @@index([companyId, userId])
}

model LedgerEntry {
 maintenanceCosts MaintenanceCost[]
 @@unique([id, propertyId, companyId])
 movementId String? @unique
 movement LeaseMovement? @relation("MovementCash", fields:[movementId,propertyId,companyId],references:[id,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
 refundMovements LeaseMovement[] @relation("RefundSource")
 depositReceiptId String? @unique
 depositReceipt DepositReceipt? @relation(fields:[depositReceiptId,propertyId,companyId],references:[id,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
 reference String @unique @default(dbgenerated("('TX-'::text || (nextval('ledger_entry_reference_seq'::regclass))::text)"))
 @@index([companyId, leaseId])
 leaseId String?
 lease Lease? @relation(fields: [leaseId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 allocations RentAllocation[]
 @@unique([id, leaseId, propertyId, companyId])
 id String @id @default(cuid())
 companyId String
 propertyId String
 createdById String
 submissionKey String
 submissionHash String
 occurredOn DateTime @db.Date
 amountCents Int
 currency String @default("USD")
 kind String
 category String
 memo String?
 version Int @default(1)
 voidedAt DateTime?
 voidReason String?
 createdAt DateTime @default(now())
 company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
 creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@unique([companyId, createdById, submissionKey])
 @@index([companyId, propertyId, occurredOn, id])
}

model UserProvision {
 targetId String?
 actorId String
 submissionKey String
 submissionHash String
 createdAt DateTime @default(now())
 actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@id([actorId, submissionKey])
}

model RentCharge {
 proration LeaseProration?
 termChangeId String?
 termsSnapshot Json?
 termChange LeaseTermChange? @relation(fields:[termChangeId,leaseId,propertyId,companyId],references:[id,leaseId,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
  movements LeaseMovement[]
 kind String @default("rent")
 category String @default("rent")
 effectiveOn DateTime? @db.Date
 credits LeaseCredit[]
 reference String @unique @default(dbgenerated("('RC-'::text || (nextval('rent_charge_reference_seq'::regclass))::text)"))
 scheduleId String?
 schedule RentSchedule? @relation(fields: [scheduleId, leaseId, propertyId, companyId], references: [id, leaseId, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 occurrences RentScheduleOccurrence[]
 graceDays Int @default(0)
 id String @id @default(cuid())
 companyId String
 propertyId String
 leaseId String
 createdById String
 submissionKey String
 submissionHash String
 periodOn DateTime @db.Date
 dueOn DateTime @db.Date
 amountCents Int
 memo String?
 version Int @default(1)
 voidedAt DateTime?
 voidReason String?
 createdAt DateTime @default(now())
 lease Lease @relation(fields: [leaseId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 allocations RentAllocation[]
 @@unique([companyId, createdById, submissionKey])
 @@unique([id, leaseId, propertyId, companyId])
 @@index([companyId, leaseId, dueOn, id])
}
model RentAllocation {
 id String @id @default(cuid())
 companyId String
 propertyId String
 leaseId String
 chargeId String
 entryId String
 amountCents Int
 createdAt DateTime @default(now())
 charge RentCharge @relation(fields: [chargeId, leaseId, propertyId, companyId], references: [id, leaseId, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 entry LedgerEntry @relation(fields: [entryId, leaseId, propertyId, companyId], references: [id, leaseId, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 @@index([companyId, leaseId])
}

model RentSchedule {
 id String @id @default(cuid())
 companyId String
 propertyId String
 leaseId String
 createdById String
 submissionKey String
 submissionHash String
 firstPeriodOn DateTime @db.Date
 lastPeriodOn DateTime? @db.Date
 nextPeriodOn DateTime @db.Date
 amountCents Int
 firstAmountCents Int?
 lastAmountCents Int?
 firstDueOn DateTime? @db.Date
 dueDay Int
 graceDays Int
 leadDays Int
 status String @default("active")
 version Int @default(1)
 lastCheckedAt DateTime?
 lastErrorCode String?
 createdAt DateTime @default(now())
 lease Lease @relation(fields: [leaseId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 charges RentCharge[]
 occurrences RentScheduleOccurrence[]
 @@unique([companyId, createdById, submissionKey])
 @@unique([id, leaseId, propertyId, companyId])
 @@index([companyId, id])
}
model RentScheduleOccurrence {
 id String @id @default(cuid())
 companyId String
 propertyId String
 leaseId String
 scheduleId String
 periodOn DateTime @db.Date
 chargeId String?
 outcome String
 createdAt DateTime @default(now())
 schedule RentSchedule @relation(fields: [scheduleId, leaseId, propertyId, companyId], references: [id, leaseId, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 charge RentCharge? @relation(fields: [chargeId, leaseId, propertyId, companyId], references: [id, leaseId, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
 @@unique([companyId, leaseId, periodOn])
 @@index([companyId, leaseId, id])
}

model DepositAccount {
  movements LeaseMovement[]
 id String @id @default(cuid())
 reference String @unique @default(dbgenerated("('DA-'::text || (nextval('deposit_account_reference_seq'::regclass))::text)"))
 companyId String
 propertyId String
 leaseId String
 createdById String
 submissionKey String
 submissionHash String
 requiredCents Int
 dueOn DateTime @db.Date
 version Int @default(1)
 createdAt DateTime @default(now())
 lease Lease @relation(fields:[leaseId,propertyId,companyId],references:[id,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
 creator User @relation("DepositAccountCreator",fields:[createdById],references:[id],onDelete:Restrict,onUpdate:Restrict)
 revisions DepositRevision[]
 receipts DepositReceipt[]
 @@unique([companyId,leaseId])
 @@unique([companyId,createdById,submissionKey])
 @@unique([id,companyId])
 @@unique([id,leaseId,propertyId,companyId])
 @@index([companyId,propertyId,id])
}
model DepositRevision {
 id String @id @default(cuid())
 companyId String
 accountId String
 createdById String
 submissionKey String
 submissionHash String
 version Int
 requiredCents Int
 dueOn DateTime @db.Date
 reason String
 createdAt DateTime @default(now())
 account DepositAccount @relation(fields:[accountId,companyId],references:[id,companyId],onDelete:Restrict,onUpdate:Restrict)
 creator User @relation("DepositRevisionCreator",fields:[createdById],references:[id],onDelete:Restrict,onUpdate:Restrict)
 @@unique([companyId,createdById,submissionKey])
 @@unique([accountId,version])
 @@index([companyId,accountId,version])
}
model DepositReceipt {
 id String @id @default(cuid())
 reference String @unique @default(dbgenerated("('DR-'::text || (nextval('deposit_receipt_reference_seq'::regclass))::text)"))
 companyId String
 propertyId String
 leaseId String
 accountId String
 createdById String
 submissionKey String
 submissionHash String
 occurredOn DateTime @db.Date
 amountCents Int
 method String
 paymentReference String?
 memo String?
 createdAt DateTime @default(now())
 account DepositAccount @relation(fields:[accountId,leaseId,propertyId,companyId],references:[id,leaseId,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
 creator User @relation("DepositReceiptCreator",fields:[createdById],references:[id],onDelete:Restrict,onUpdate:Restrict)
 cashEntries LedgerEntry[]
 @@unique([companyId,createdById,submissionKey])
 @@unique([id,propertyId,companyId])
 @@index([companyId,accountId,id])
}

model LeaseCredit {
 id String @id @default(cuid())
 reference String @unique @default(dbgenerated("('CN-'::text || (nextval('lease_credit_reference_seq'::regclass))::text)"))
 companyId String
 propertyId String
 leaseId String
 chargeId String
 createdById String
 submissionKey String
 submissionHash String
 kind String
 effectiveOn DateTime @db.Date
 amountCents Int
 reason String
 createdAt DateTime @default(now())
 charge RentCharge @relation(fields:[chargeId,leaseId,propertyId,companyId],references:[id,leaseId,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
 reversal LeaseCreditReversal?
 @@unique([id,leaseId,propertyId,companyId])
 @@unique([companyId,createdById,submissionKey])
 @@index([companyId,leaseId])
}
model LeaseCreditReversal {
 id String @id @default(cuid())
 reference String @unique @default(dbgenerated("('CR-'::text || (nextval('lease_credit_reversal_reference_seq'::regclass))::text)"))
 companyId String
 propertyId String
 leaseId String
 creditId String @unique
 createdById String
 submissionKey String
 submissionHash String
 effectiveOn DateTime @db.Date
 reason String
 createdAt DateTime @default(now())
 credit LeaseCredit @relation(fields:[creditId,leaseId,propertyId,companyId],references:[id,leaseId,propertyId,companyId],onDelete:Restrict,onUpdate:Restrict)
