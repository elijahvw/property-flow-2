// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String     @id @default(cuid())
  name      String
  domain    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  properties Property[]
  status     String @default("active")
  memberships CompanyMembership[]
  invitations Invitation[]
  maintenanceRequests MaintenanceRequest[]
  units Unit[]
  leases Lease[]
  ledgerEntries LedgerEntry[]
}

model User {
  id         String   @id // This will be the Auth0 ID
  email      String   @unique
  name       String?
  role       String   @default("unassigned") // Legacy migration evidence; never authorizes requests.
  platformRole String?
  status     String   @default("active")
  accessInitializedAt DateTime?
  emailVerified Boolean @default(false)
  verificationSentAt DateTime?
  passwordSetupSentAt DateTime?
  firstSignedInAt DateTime?
  provisions UserProvision[]
  identities Identity[]
  maintenanceRequests MaintenanceRequest[]
  leases Lease[] @relation("LeaseResident")
  createdLeases Lease[] @relation("LeaseCreator")
  createdUnits Unit[]
  createdLedgerEntries LedgerEntry[]
  membership CompanyMembership?
  sessions Session[]
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model Identity {
  id String @id @default(cuid())
  issuer String
  subject String
  userId String
  user User @relation(fields: [userId], references: [id])
  @@unique([issuer, subject])
}

model CompanyMembership {
  userId String @id
  companyId String
  role String
  status String @default("active")
  version Int @default(1)
  user User @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments ResidentPropertyAssignment[]
  @@unique([userId, companyId])
  @@index([companyId])
}

model Invitation {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  email String
  role String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([companyId])
}

model Session {
  tokenHash String @id
  csrfToken String
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  idleExpiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model LoginTransaction {
  stateHash String @id
  bindingHash String
  verifier String
  nonce String
  returnTo String
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorId String
  companyId String?
  action String
  targetId String?
  detail Json?
  requestId String
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}

model Property {
  units Unit[]
  leases Lease[]
  ledgerEntries LedgerEntry[]
  maintenanceRequests MaintenanceRequest[]
  assignments ResidentPropertyAssignment[]
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@unique([id, companyId])
}

model ResidentPropertyAssignment {
  companyId String
  propertyId String
  userId String
  createdAt DateTime @default(now())
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  membership CompanyMembership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Restrict)
  @@id([propertyId, userId])
  @@index([companyId, userId])
}

model MaintenanceRequest {
  submissionKey String?
  submissionHash String?
  @@unique([companyId, requesterId, submissionKey])
  id String @id @default(cuid())
  companyId String
  propertyId String
  requesterId String
  title String
  description String
  priority String @default("normal")
  status String @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  requester User @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([companyId, status, propertyId])
  @@index([companyId, requesterId])
}

model Unit {
  createdById String
  submissionKey String
  submissionHash String
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  id String @id @default(cuid())
  companyId String
  propertyId String
  label String
  status String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  leases Lease[]
  @@unique([id, propertyId, companyId])
  @@unique([companyId, propertyId, label])
  @@index([companyId, propertyId, id])
}
model Lease {
  id String @id @default(cuid())
  companyId String
  propertyId String
  unitId String
  residentId String
  createdById String
  submissionKey String
  submissionHash String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  rentCents Int
  currency String @default("USD")
  status String @default("draft")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  unit Unit @relation(fields: [unitId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  resident User @relation("LeaseResident", fields: [residentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("LeaseCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, propertyId, id])
  @@index([companyId, unitId])
}

model LedgerEntry {
 id String @id @default(cuid())
 companyId String
 propertyId String
 createdById String
 submissionKey String
 submissionHash String
 occurredOn DateTime @db.Date
 amountCents Int
 currency String @default("USD")
 kind String
 category String
 memo String?
 version Int @default(1)
 voidedAt DateTime?
 voidReason String?
 createdAt DateTime @default(now())
 company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
 creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@unique([companyId, createdById, submissionKey])
 @@index([companyId, propertyId, occurredOn, id])
}

model UserProvision {
 targetId String?
 actorId String
 submissionKey String
 submissionHash String
 createdAt DateTime @default(now())
 actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@id([actorId, submissionKey])
}
