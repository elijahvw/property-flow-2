// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  taskDrafts TaskDraft[]
  notificationPreferences NotificationPreference[]
  notificationPreferenceActions NotificationPreferenceAction[]
  notificationPreferenceFence NotificationPreferenceFence?
  expenseImports ExpenseImportBatch[]
  expenseImportActions ExpenseImportAction[]
  importedExpenseSources ImportedExpenseSource[]
  leaseDocumentShares LeaseDocumentShare[]
  leaseDocumentShareActions LeaseDocumentShareAction[]
  prospects Prospect[]
  prospectActions ProspectAction[]
  unitAvailability UnitAvailability[]
  unitAvailabilityRevisions UnitAvailabilityRevision[]
  unitImports UnitImportBatch[]
  unitImportActions UnitImportAction[]
  subscription CompanySubscription?
  subscriptionRevisions CompanySubscriptionRevision[]
  featureUsage CompanyFeatureUsage[]
  saasInvoices SaaSInvoice[]
  saasPayments SaaSPayment[]
  saasPaymentReversals SaaSPaymentReversal[]
  saasInvoiceEvents SaaSInvoiceEvent[]
  salesDemo SalesDemo?
  preventivePlans PreventivePlan[]
  preventiveActions PreventiveAction[]
  preventiveOccurrences PreventiveOccurrence[]
  vendors Vendor[]
  vendorActions VendorAction[]
  id        String     @id @default(cuid())
  name      String
  domain    String?    @unique
  legalName String?
  contactName String?
  contactEmail String?
  contactPhone String?
  website String?
  addressLine1 String?
  addressLine2 String?
  city String?
  region String?
  postalCode String?
  country String?
  timezone String @default("America/New_York")
  adminNotes String?
  version Int @default(1)
  createdById String?
  submissionKey String?
  submissionHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  residentContacts ResidentContact[]
  users     User[]
  properties Property[]
  status     String @default("active")
  memberships CompanyMembership[]
  invitations Invitation[]
  maintenanceRequests MaintenanceRequest[]
  units Unit[]
  leases Lease[]
  ledgerEntries LedgerEntry[]
  @@unique([createdById, submissionKey])
}

// SaaS billing is company metadata; it never posts to a tenant rent/cash ledger.
model PlatformPlan {
  id String @id @default(cuid())
  name String
  version Int @default(1)
  currency String @default("USD")
  monthlyPriceCents Int
  features Json
  archivedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  submissionKey String
  submissionHash String
  subscriptions CompanySubscription[]
  @@unique([name, version])
  @@unique([createdById, submissionKey])
}

model CompanySubscription {
  companyId String @id
  company Company @relation(fields: [companyId], references: [id])
  version Int @default(1)
  planId String?
  plan PlatformPlan? @relation(fields: [planId], references: [id])
  status String @default("active")
  trialEndsAt DateTime?
  currentPeriodStart DateTime? @db.Date
  currentPeriodEnd DateTime? @db.Date
  billingEmail String?
  featureOverrides Json @default("{}")
  overrideReason String?
  overrideExpiresAt DateTime?
  updatedById String
  updatedAt DateTime @updatedAt
}

model CompanySubscriptionRevision {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  version Int
  snapshot Json
  reason String
  actorId String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  @@unique([companyId, version])
  @@unique([companyId, submissionKey])
}

model CompanyFeatureUsage {
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  area String
  day DateTime @db.Date
  successfulReads Int @default(0)
  successfulWrites Int @default(0)
  @@id([companyId, area, day])
  @@index([companyId, day])
}

model SaaSInvoice {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  number Int @unique @default(autoincrement())
  billingName String
  billingEmail String?
  billingAddress Json
  planName String
  planVersion Int
  currency String @default("USD")
  monthlyPriceCents Int
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  issuedAt DateTime @default(now())
  dueOn DateTime @db.Date
  status String @default("issued")
  version Int @default(1)
  submissionKey String
  submissionHash String
  createdById String
  payments SaaSPayment[]
  events SaaSInvoiceEvent[]
  @@unique([companyId, submissionKey])
  @@unique([companyId, id])
  @@index([companyId, issuedAt, id])
}

model SaaSPayment {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  invoiceId String
  invoice SaaSInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id])
  amountCents Int
  receivedOn DateTime @db.Date
  paymentReference String
  submissionKey String
  submissionHash String
  createdById String
  createdAt DateTime @default(now())
  reversal SaaSPaymentReversal?
  @@unique([companyId, submissionKey])
  @@unique([companyId, id])
  @@index([companyId, invoiceId])
}

model SaaSPaymentReversal {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  paymentId String @unique
  payment SaaSPayment @relation(fields: [companyId, paymentId], references: [companyId, id])
  reason String
  createdById String
  createdAt DateTime @default(now())
  submissionKey String
  submissionHash String
  @@unique([companyId, submissionKey])
  @@unique([companyId, paymentId])
}

model SaaSInvoiceEvent {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  invoiceId String
  invoice SaaSInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id])
  action String
  detail Json
  createdById String
  createdAt DateTime @default(now())
  submissionKey String?
  submissionHash String?
  @@unique([companyId, submissionKey])
  @@index([companyId, invoiceId, createdAt])
}

model User {
  demoSetups SalesDemoSetup[]
  taskDrafts TaskDraft[]
  notificationPreferences NotificationPreference[]
  notificationPreferenceActions NotificationPreferenceAction[]
  receivedDocumentShares LeaseDocumentShare[] @relation("SharedDocumentRecipient")
  salesDemos SalesDemo[] @relation("SalesDemoOwner")
  createdSalesDemos SalesDemo[] @relation("SalesDemoCreator")
  notificationEvents NotificationEvent[]
  inboxNotifications InboxNotification[]
  notificationActions NotificationAction[]
  agreementRevisions AgreementRevision[]
  inspectionRevisions InspectionRevision[]
  preventiveActions PreventiveAction[]
  vendorActions VendorAction[]
  guideState Json?
  guideVersion Int @default(1)
  accountProfile AccountProfile?
  id         String   @id // This will be the Auth0 ID
  email      String   @unique
  name       String?
  role       String   @default("unassigned") // Legacy migration evidence; never authorizes requests.
  platformRole String?
  status     String   @default("active")
  accessInitializedAt DateTime?
  emailVerified Boolean @default(false)
  verificationSentAt DateTime?
  passwordSetupSentAt DateTime?
  firstSignedInAt DateTime?
  provisions UserProvision[]
  identities Identity[]
  maintenanceRequests MaintenanceRequest[]
  leases Lease[] @relation("LeaseResident")
  createdMaintenanceUpdates MaintenanceUpdate[]
  createdMaintenanceCosts MaintenanceCost[] @relation("MaintenanceCostCreator")
  unlinkedMaintenanceCosts MaintenanceCost[] @relation("MaintenanceCostUnlinker")
  residentContacts ResidentContact[] @relation("ContactAccount")
  accountInvitations Invitation[] @relation("InvitationAccount")
  createdResidentContacts ResidentContact[] @relation("ContactCreator")
  leaseParticipants LeaseParticipant[]
  createdLeaseParticipants LeaseParticipant[] @relation("LeaseParticipantCreator")
  approvedLeaseInvitations Invitation[] @relation("LeaseInvitationApprover")
  createdLeases Lease[] @relation("LeaseCreator")
  createdUnits Unit[]
  createdLedgerEntries LedgerEntry[]
  createdDepositAccounts DepositAccount[] @relation("DepositAccountCreator")
  createdDepositRevisions DepositRevision[] @relation("DepositRevisionCreator")
  createdDepositReceipts DepositReceipt[] @relation("DepositReceiptCreator")
  documentVersions DocumentVersion[]
  workOrderActions WorkOrderAction[]
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceAssignee")
  membership CompanyMembership?
  sessions Session[] @relation("SessionActor")
  impersonatedSessions Session[] @relation("SessionTarget")
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model SalesDemo {
  replacementSetups SalesDemoSetup[] @relation("SalesDemoReplacement")
  setup SalesDemoSetup?
  id String @id @default(cuid())
  companyId String @unique
  ownerId String
  createdById String
  submissionKey String
  submissionHash String
  seedVersion Int
  status String @default("ready")
  version Int @default(1)
  manifest Json
  createdAt DateTime @default(now())
  retiredAt DateTime?
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  owner User @relation("SalesDemoOwner",fields:[ownerId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  creator User @relation("SalesDemoCreator",fields:[createdById],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([createdById,submissionKey])
  @@index([ownerId,status])
}

model SalesDemoSetup {
  id String @id
  createdById String
  submissionKey String
  submissionHash String
  status String @default("pending")
  credentialsCipher String
  accounts Json @default("{}")
  salesDemoId String? @unique
  sourceDemoId String?
  sourceVersion Int?
  blueprint Json?
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation(fields:[createdById],references:[id],onDelete:Restrict,onUpdate:Restrict)
  demo SalesDemo? @relation(fields:[salesDemoId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  sourceDemo SalesDemo? @relation("SalesDemoReplacement",fields:[sourceDemoId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([createdById,submissionKey])
  @@index([sourceDemoId,status])
}

model Identity {
  id String @id @default(cuid())
  issuer String
  subject String
  userId String
  user User @relation(fields: [userId], references: [id])
  @@unique([issuer, subject])
}

model CompanyMembership {
  maintenanceExecution Boolean @default(false)
  staffPropertyScope String @default("all")
  staffProperties StaffPropertyAccess[]
  contactName String?
  contactPhone String?
  emergencyContactName String?
  emergencyContactPhone String?
  managementNotes String?
  userId String @id
  companyId String
  role String
  status String @default("active")
  version Int @default(1)
  user User @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments ResidentPropertyAssignment[]
  @@unique([userId, companyId])
  @@index([companyId])
}

model Invitation {
  @@unique([id, companyId])
  version Int @default(1)
  submissionKey String?
  submissionHash String?
  replacesId String?
  replaces Invitation? @relation("InvitationReplacement", fields:[replacesId,companyId], references:[id,companyId], onDelete:Restrict, onUpdate:Restrict, map:"Invitation_replacement_company_fkey")
  replacements Invitation[] @relation("InvitationReplacement")
  deliveryStatus String @default("not_requested")
  deliveryRequestedAt DateTime?
  deliveryUpdatedAt DateTime?
  @@unique([companyId, createdBy, submissionKey])
  @@index([companyId, createdAt, id])
  @@index([accountId])
  accountId String?
  account User? @relation("InvitationAccount", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contactLeaseApprovals Json?
  contactId String?
  contact ResidentContact? @relation(fields:[contactId,companyId],references:[id,companyId],onDelete:Restrict,onUpdate:Restrict)
  @@index([companyId,contactId])
  leaseId String?
  propertyId String?
  participantRole String?
  participantName String?
  participantStartsOn DateTime? @db.Date
  approvedAt DateTime?
  approvedBy String?
  lease Lease? @relation(fields: [leaseId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "Invitation_lease_fkey")
  approver User? @relation("LeaseInvitationApprover", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  email String
  role String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([companyId])
  @@index([companyId, leaseId])
}

model Session {
  tokenHash String @id
  csrfToken String
  userId String
  user User @relation("SessionActor", fields: [userId], references: [id])
  impersonatedUserId String?
  impersonatedUser User? @relation("SessionTarget", fields: [impersonatedUserId], references: [id], onDelete: Restrict)
  impersonationExpiresAt DateTime?
  impersonationReason String?
  impersonationCompanyId String?
  impersonationMembershipVersion Int?
  expiresAt DateTime
  idleExpiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([impersonatedUserId])
  @@index([expiresAt])
}

model LoginTransaction {
  stateHash String @id
  bindingHash String
  verifier String
  nonce String
  returnTo String
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorId String
  companyId String?
  action String
  targetId String?
  detail Json?
  requestId String
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

model Property {
  taskDrafts TaskDraft[]
  prospects Prospect[]
  notificationEvents NotificationEvent[]
  preventivePlans PreventivePlan[]
  staffAccess StaffPropertyAccess[]
  propertyType String?
  yearBuilt Int?
  parcelId String?
  countryCode String?
  notes String?
  version Int @default(1)
  createdById String?
  submissionKey String?
  submissionHash String?
  @@unique([companyId, createdById, submissionKey])
  units Unit[]
  leases Lease[]
  ledgerEntries LedgerEntry[]
  maintenanceRequests MaintenanceRequest[]
  assignments ResidentPropertyAssignment[]
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@unique([id, companyId])
}

model StaffPropertyAccess {
  companyId String
  propertyId String
  userId String
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  membership CompanyMembership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade, onUpdate: Restrict)
  @@id([propertyId, userId])
  @@index([companyId, userId])
}

model ResidentPropertyAssignment {
  companyId String
  propertyId String
  userId String
  createdAt DateTime @default(now())
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  membership CompanyMembership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Restrict, onUpdate: Restrict)
  @@id([propertyId, userId])
  @@index([companyId, userId])
}

// Partial calendar_request_targets index is managed by migration037 (unresolved dated requests).
model MaintenanceRequest {
  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)], map: "maintenance_directory_order")
  notificationEvents NotificationEvent[]
  preventiveOccurrence PreventiveOccurrence?
  vendorId String?
  vendor Vendor? @relation(fields:[vendorId, companyId], references:[id, companyId], onDelete:Restrict, onUpdate:Restrict, map:"maintenance_vendor_scope")
  vendorActions VendorAction[]
  @@index([companyId, vendorId, createdAt, id])
  documents PrivateDocument[]
  assignee User? @relation("MaintenanceAssignee",fields:[assigneeId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  assigneeId String?
  executionStatus String @default("unassigned")
  workActions WorkOrderAction[]
  @@index([companyId, assigneeId, executionStatus])
  costs MaintenanceCost[]
  updates MaintenanceUpdate[]
  submissionKey String?
  submissionHash String?
  @@unique([companyId, requesterId, submissionKey])
  id String @id @default(cuid())
  companyId String
  propertyId String
  requesterId String
  unitId String?
  category String @default("other")
  targetOn DateTime? @db.Date
  version Int @default(1)
  unit Unit? @relation(fields: [unitId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "maintenance_unit_scope")
  title String
  description String
  priority String @default("normal")
  status String @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  requester User @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([companyId, status, propertyId])
  @@index([companyId, requesterId])
  @@index([companyId, unitId], map: "maintenance_unit_lookup")
  @@unique([id, companyId])
  @@unique([id, propertyId, companyId])
}

model Vendor {
  id String @id @default(cuid())
  companyId String
  name String
  nameKey String
  service String?
  contactName String?
  email String?
  phone String?
  notes String?
  status String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId], references:[id], onDelete:Restrict, onUpdate:Restrict)
  requests MaintenanceRequest[]
  actions VendorAction[]
  @@unique([id, companyId])
  @@unique([companyId, nameKey])
  @@index([companyId, status, name, id])
}

model VendorAction {
  id String @id @default(cuid())
  companyId String
  vendorId String?
  requestId String?
  actorId String
  action String
  changed Boolean @default(true)
  snapshot Json
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId], references:[id], onDelete:Restrict, onUpdate:Restrict)
  vendor Vendor? @relation(fields:[vendorId, companyId], references:[id, companyId], onDelete:Restrict, onUpdate:Restrict)
  request MaintenanceRequest? @relation(fields:[requestId, companyId], references:[id, companyId], onDelete:Restrict, onUpdate:Restrict)
  actor User @relation(fields:[actorId], references:[id], onDelete:Restrict, onUpdate:Restrict)
  @@unique([companyId, actorId, submissionKey])
  @@index([companyId, vendorId, createdAt, id])
  @@index([companyId, requestId, createdAt, id])
}

model MaintenanceCost {
  id String @id @default(cuid())
  companyId String
  propertyId String
  requestId String
  entryId String
  createdById String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  version Int @default(1)
  unlinkedAt DateTime?
  unlinkedById String?
  unlinkReason String?
  request MaintenanceRequest @relation(fields: [requestId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  entry LedgerEntry @relation(fields: [entryId, propertyId, companyId], references: [id, propertyId, companyId], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation("MaintenanceCostCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unlinker User? @relation("MaintenanceCostUnlinker", fields: [unlinkedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, requestId, id])
  @@index([companyId, entryId])
}

model MaintenanceUpdate {
  id String @id @default(cuid())
  companyId String
  requestId String
  content String
  visibility String @default("internal")
  authorType String @default("team")
  createdById String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  request MaintenanceRequest @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  @@index([companyId, requestId, createdAt, id])
}

model Unit {
  prospects Prospect[]
  availability UnitAvailability?
  availabilityRevisions UnitAvailabilityRevision[]
  preventivePlans PreventivePlan[]
  bedrooms Int?
  bathroomsHundredths Int?
  squareFeet Int?
  marketRentCents Int?
  floor String?
  notes String?
  createdById String
  submissionKey String
  submissionHash String
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  id String @id @default(cuid())
  companyId String
  propertyId String
  label String
  status String @default("active")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property Property @relation(fields: [propertyId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  maintenanceRequests MaintenanceRequest[]
  leases Lease[]
  @@unique([id, propertyId, companyId])
  @@unique([companyId, propertyId, label])
  @@index([companyId, propertyId, id])
}

model UnitAvailability {
  unitId String @id
  companyId String
  propertyId String
  company Company @relation(fields: [companyId], references: [id])
  unit Unit @relation(fields: [unitId, propertyId, companyId], references: [id, propertyId, companyId])
  version Int @default(1)
  condition String
  availableOn DateTime? @db.Date
  reason String
  updatedById String
  updatedAt DateTime @updatedAt
  @@unique([unitId, propertyId, companyId])
  @@index([companyId, propertyId])
}

model UnitAvailabilityRevision {
  id String @id @default(cuid())
  companyId String
  unitId String
  propertyId String
  company Company @relation(fields: [companyId], references: [id])
  unit Unit @relation(fields: [unitId, propertyId, companyId], references: [id, propertyId, companyId])
  version Int
  snapshot Json
  reason String
  actorId String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  @@unique([unitId, version])
  @@unique([companyId, submissionKey])
  @@index([companyId, unitId, createdAt])
}

model UnitImportBatch {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  status String @default("preview")
  version Int @default(1)
  fileName String
  sourceHash String
  sourceRows Json
  preview Json
  createdById String
  submissionKey String
  submissionHash String
  committedAt DateTime?
  cancelledAt DateTime?
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actions UnitImportAction[]
  @@unique([companyId, submissionKey])
  @@unique([companyId, id])
  @@index([companyId, createdAt, id])
}

model UnitImportAction {
  id String @id @default(cuid())
  companyId String
  batchId String
  company Company @relation(fields: [companyId], references: [id])
  batch UnitImportBatch @relation(fields: [companyId, batchId], references: [companyId, id])
  action String
  detail Json
  createdById String
  submissionKey String
  submissionHash String
  createdAt DateTime @default(now())
  @@unique([companyId, submissionKey])
  @@index([companyId, batchId, createdAt])
}
model ResidentContact {
  prospects Prospect[]
  status String @default("active")
  preferredName String?
  alternatePhone String?
  preferredContact String?
  addressLine1 String?
  addressLine2 String?
  city String?
  region String?
  postalCode String?
  country String?
  emergencyRelationship String?
  createdById String?
  submissionKey String?
  submissionHash String?
  creator User? @relation("ContactCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, createdById, submissionKey])
  compatibilityProfile Json?
  id String @id @default(cuid())
  companyId String
  userId String?
  name String
  email String?
  phone String?
  emergencyContactName String?
  emergencyContactPhone String?
  managementNotes String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User? @relation("ContactAccount", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitations Invitation[]
  primaryLeases Lease[]
  participants LeaseParticipant[]
  @@unique([id, companyId])
  @@unique([companyId, userId])
  @@index([companyId, name, id])
}

model Lease {
  documentShares LeaseDocumentShare[]
  prospects Prospect[]
  notificationEvents NotificationEvent[]
  agreements LeaseAgreement[]
