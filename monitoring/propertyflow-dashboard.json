      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "TRACES_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"propertyflow-server\" && resource.deployment.environment=\"dev\"}",
          "limit": 20,
          "legendFormat": "{{job_outcome}}"
        }
      ]
