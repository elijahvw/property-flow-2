{
  "uid": "propertyflow-dev-operations",
  "title": "Property Flow \u00b7 Dev operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "propertyflow",
    "dev"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Database readiness",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "METRICS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(propertyflow_readiness{service_name=\"propertyflow-server\",deployment_environment=\"dev\"})",
          "refId": "A",
          "legendFormat": "{{job_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "App uptime",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "METRICS_UID"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(propertyflow_process_uptime_seconds{service_name=\"propertyflow-server\",deployment_environment=\"dev\"})",
          "refId": "A",
          "legendFormat": "{{job_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "API 5xx ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "METRICS_UID"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(propertyflow_http_requests_total{service_name=\"propertyflow-server\",deployment_environment=\"dev\",http_response_status_code=~\"5..\",http_route!~\"/api/(ready|health|telemetry)\"}[5m])) or vector(0)) / clamp_min(sum(rate(propertyflow_http_requests_total{service_name=\"propertyflow-server\",deployment_environment=\"dev\",http_route!~\"/api/(ready|health|telemetry)\"}[5m])),0.001)",
          "legendFormat": "5xx / requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Rent billing last successful run age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "METRICS_UID"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(propertyflow_worker_last_success_seconds{service_name=\"propertyflow-server\",deployment_environment=\"dev\"})",
          "legendFormat": "Age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "METRICS_UID"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(http_route)(rate(propertyflow_http_requests_total{service_name=\"propertyflow-server\",deployment_environment=\"dev\",http_route!~\"/api/(ready|health|telemetry)\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "API errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "METRICS_UID"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(http_route)(rate(propertyflow_http_requests_total{service_name=\"propertyflow-server\",deployment_environment=\"dev\",http_response_status_code=~\"5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
